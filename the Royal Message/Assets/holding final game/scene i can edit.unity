  m_Script: {fileID: 11500000, guid: 5d085efc94c8cfa4086a9706b52644c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  conversation:
  - characterName: John
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Hello! how are you?
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices:
    - choiceText: Doing well
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
      followUpDialogue:
      - characterName: Jerry
        characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
        sentence: Doing well!
        onLineStart:
          m_PersistentCalls:
            m_Calls: []
        choices: []
      - characterName: John
        characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
        sentence: That is great to hear!
        onLineStart:
          m_PersistentCalls:
            m_Calls: []
        choices: []
    - choiceText: Not doing well
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
      followUpDialogue:
      - characterName: Jerry
        characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
        sentence: Not doing well...
        onLineStart:
          m_PersistentCalls:
            m_Calls: []
        choices: []
      - characterName: John
        characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
        sentence: Oh no! I hope you feel better! Is there anything I can do to help?
        onLineStart:
          m_PersistentCalls:
            m_Calls: []
        choices:
        - choiceText: Ask for books
          onChoiceSelected:
            m_PersistentCalls:
              m_Calls: []
          followUpDialogue:
          - characterName: Jerry
            characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
            sentence: Do you have any books?
            onLineStart:
              m_PersistentCalls:
                m_Calls: []
            choices: []
          - characterName: John
            characterPortrait: {fileID: -960271038206414302, guid: 976c158b6443e5c40a6a96a909eec2f6, type: 3}
            sentence: Sure I do! Here you go...
            onLineStart:
              m_PersistentCalls:
                m_Calls: []
            choices: []
