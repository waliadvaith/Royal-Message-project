  m_Script: {fileID: 11500000, guid: 5d085efc94c8cfa4086a9706b52644c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  conversation:
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Geez... I feel... a bit... nervous.. sometimes...
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Friendly Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Yeah sometimes I feel that way too when I'm around people I don't know
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Wait.... Really?
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Friendly Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Yeah but sometimes I wonder why your so nervous when it comes to converstations
      but you're not so nervous when it comes to battles.
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Well... sometimes it's... just comes... very natural... to me... like
      that...
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Friendly Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Oh ok. I see but you go ahead and defeat those Knights! You Got This
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 4126524051334895449, guid: 7590bcb3e3049fb4baaaf5399c087f85, type: 3}
          m_TargetAssemblyTypeName: MoralityManager, Assembly-CSharp
          m_MethodName: AddMorality
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Thanks.....
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 4126524051334895449, guid: 7590bcb3e3049fb4baaaf5399c087f85, type: 3}
