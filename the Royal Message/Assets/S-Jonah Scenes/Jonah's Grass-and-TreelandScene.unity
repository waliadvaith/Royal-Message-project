  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Uh...
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Practice Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Oh did I accidentally provoked fear on you
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Yeah... you did...
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Practice Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Sorry about that, I was just trying to practice my skills of dramatic
