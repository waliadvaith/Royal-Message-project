  m_Script: {fileID: 11500000, guid: 5d085efc94c8cfa4086a9706b52644c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  conversation:
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: I have confidence but... I don't... know why it... dosen't come...
      to me... like that
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Birds Carrier Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Well theres a way to think about differently then you normally would
      think
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Wait.... really?
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Birds Carrier Dude
    characterPortrait: {fileID: 398647834585502450, guid: ba8786717bb7ba54faf91dda11ae39e7, type: 3}
    sentence: Yeah! You just got to think like your in a battle as it can help you
      gain a lot of confidence.
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  - characterName: Messanger
    characterPortrait: {fileID: 6863246505373101655, guid: ea8b8e0fd76013344a5160746e085530, type: 3}
    sentence: Oh... ok... I keep that in mind..
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
    choices: []
  promptText: {fileID: 0}
